# Copy to .env and fill in your values — never commit .env to git

# Circle Payments API
CIRCLE_API_KEY=your_circle_api_key_here
CIRCLE_WALLET_ID=your_circle_wallet_id_here

# Blockchain (Stellar or EVM)
STELLAR_BUYER_SECRET_KEY=your_stellar_secret_key_here
INFURA_RPC_URL=https://mainnet.infura.io/v3/your_project_id

# Delivery Oracle
ORACLE_WEBHOOK_SECRET=your_webhook_secret_here

# Slack notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
